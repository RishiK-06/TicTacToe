      "boundElements": [],
      "updated": 1793378608687,
      "link": null,
      "locked": false,
      "text": "def get_empty_positions(board):\n    return [i for i in range(9)\n            if isinstance(board[i], int)]",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 22,
      "lineHeight": 1.25,
      "autoResize": false,
      "originalText": "def get_empty_positions(board):\n    return [i for i in range(9)\n            if isinstance(board[i], int)]",
