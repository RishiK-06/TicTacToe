    {
      "id": "07be676efe244acf87d7",
      "type": "text",
      "x": 2777.8019864265784,
      "y": 563.3463453779873,
      "width": 754,
      "height": 127.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0J",
      "roundness": {
        "type": 3
      },
      "seed": 403981,
      "version": 140,
      "versionNonce": 1206432664,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793378608687,
      "link": null,
      "locked": false,
      "text": "def print_board(board):\n    for row in range(3):\n        cells = board[row*3:(row+1)*3]\n        print(\" | \".join(str(cell) for cell in cells))\n        if row < 2:\n            print(\"---------\")",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 20,
      "lineHeight": 1.25,
      "autoResize": false,
      "originalText": "def print_board(board):\n    for row in range(3):\n        cells = board[row*3:(row+1)*3]\n        print(\" | \".join(str(cell) for cell in cells))\n        if row < 2:\n            print(\"---------\")",
      "containerId": null,
      "labelPosition": 0.5,
      "baseFontSize": null
    },
