      "labelPosition": 0.5,
      "baseFontSize": null
    },
    {
      "id": "3e361f51889c434a9a17",
      "type": "text",
      "x": 2777.8019864265784,
      "y": 933.3463453779873,
      "width": 754,
      "height": 297.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0R",
      "roundness": {
        "type": 3
      },
      "seed": 158563,
      "version": 140,
      "versionNonce": 734632856,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793378608687,
      "link": null,
      "locked": false,
      "text": "def computer_move(board):\n    best_move = None\n    best_value = -999\n\n    for position in get_empty_positions(board):\n        board[position] = \"O\"\n        value = minimax_score(False)\n        board[position] = position + 1\n\n        if value > best_value:\n            best_value = value\n            best_move = position\n\n    return best_move",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 20,
      "lineHeight": 1.25,
      "autoResize": false,
      "originalText": "def computer_move(board):\n    best_move = None\n    best_value = -999\n\n    for position in get_empty_positions(board):\n        board[position] = \"O\"\n        value = minimax_score(False)\n        board[position] = position + 1\n\n        if value > best_value:\n            best_value = value\n            best_move = position\n\n    return best_move",
      "containerId": null,
      "labelPosition": 0.5,
      "baseFontSize": null
    },
    {
      "id": "28342bf36ed8435297c2",
      "type": "text",
      "x": 2790.2966973279945,
      "y": 1247.6427950328034,
      "width": 754,
      "height": 63.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0S",
      "roundness": {
        "type": 3
      },
      "seed": 790518,
      "version": 231,
      "versionNonce": 1279420568,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793378608687,
      "link": null,
      "locked": false,
      "text": "WORKING: It tests each empty cell as a possible O move, asks Minimax how that move\ncan turn out, then undoes the test. It remembers the position with the highest score and\nreturns it.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 20,
      "lineHeight": 1.25,
      "autoResize": false,
      "originalText": "WORKING: It tests each empty cell as a possible O move, asks Minimax how that move can turn out, then undoes the test. It remembers the position with the highest score and returns it.",
      "containerId": null,
      "labelPosition": 0.5,
      "baseFontSize": null
    },
