      "text": "6. computer_move(board)",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 26,
      "lineHeight": 1.25,
      "autoResize": false,
      "originalText": "6. computer_move(board)",
