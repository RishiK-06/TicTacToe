      "text": "5. minimax_score(is_computer_turn)",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 26,
      "lineHeight": 1.25,
      "autoResize": false,
      "originalText": "5. minimax_score(is_computer_turn)",
      "containerId": null,
      "labelPosition": 0.5,
      "baseFontSize": null
    },
    {
      "id": "9472c32e776c401aa98f",
      "type": "text",
      "x": 1941.6976206817722,
      "y": 916.8567804280049,
      "width": 529.2036872810287,
      "height": 305.5949538449557,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0N",
      "roundness": {
        "type": 3
      },
      "seed": 602187,
      "version": 658,
      "versionNonce": 607923523,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793382273330,
      "link": null,
      "locked": false,
      "text": "def minimax_score(is_computer_turn):\n    if check_win(board, \"O\"): return 1\n    if check_win(board, \"X\"): return -1\n    if not get_empty_positions(board): return 0\n\n    if is_computer_turn:\n        best = -999\n        for position in get_empty_positions(board):\n            board[position] = \"O\"\n            value = minimax_score(False)\n            board[position] = position + 1\n            best = max(best, value)\n        return best\n    else:\n        best = 999\n        for position in get_empty_positions(board):\n            board[position] = \"X\"\n            value = minimax_score(True)\n            board[position] = position + 1\n            best = min(best, value)\n        return best",
      "fontSize": 11.64171252742689,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "lineHeight": 1.25,
      "autoResize": false,
      "originalText": "def minimax_score(is_computer_turn):\n    if check_win(board, \"O\"): return 1\n    if check_win(board, \"X\"): return -1\n    if not get_empty_positions(board): return 0\n\n    if is_computer_turn:\n        best = -999\n        for position in get_empty_positions(board):\n            board[position] = \"O\"\n            value = minimax_score(False)\n            board[position] = position + 1\n            best = max(best, value)\n        return best\n    else:\n        best = 999\n        for position in get_empty_positions(board):\n            board[position] = \"X\"\n            value = minimax_score(True)\n            board[position] = position + 1\n            best = min(best, value)\n        return best",
      "containerId": null,
      "labelPosition": 0.5,
      "baseFontSize": null
    },
    {
      "id": "966390eb93904a0faa9e",
      "type": "text",
      "x": 1949.7385984057464,
      "y": 1241.0935151807755,
      "width": 627.9638796201264,
      "height": 56.383805432848696,
      "angle": 0.0022927011722071455,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0O",
      "roundness": {
        "type": 3
      },
      "seed": 615272,
      "version": 2097,
      "versionNonce": 218985624,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793378608687,
      "link": null,
      "locked": false,
      "text": "WORKING: This nested function explores possible future moves. O wants the largest\nscore; X is assumed to choose the smallest score. It stops when someone wins or\nthe board is full. Each test move is undone (backtracking).",
      "fontSize": 15.035681448759686,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 19,
      "lineHeight": 1.25,
      "autoResize": false,
      "originalText": "WORKING: This nested function explores possible future moves. O wants the largest score; X is assumed to choose the smallest score. It stops when someone wins or the board is full. Each test move is undone (backtracking).",
      "containerId": null,
      "labelPosition": 0.5,
      "baseFontSize": null
    },
