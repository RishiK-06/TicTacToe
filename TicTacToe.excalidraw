      "text": "7. Main game loop — human, computer, replay",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 26,
      "lineHeight": 1.25,
      "autoResize": false,
      "originalText": "7. Main game loop — human, computer, replay",
      "containerId": null,
      "labelPosition": 0.5,
      "baseFontSize": null
    },
    {
      "id": "21d2231d280a495ebf0b",
      "type": "text",
      "x": 1932.8019864265784,
      "y": 1413.3463453779873,
      "width": 1614,
      "height": 202.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0V",
      "roundness": {
        "type": 3
      },
      "seed": 57217,
      "version": 140,
      "versionNonce": 607326104,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793378608687,
      "link": null,
      "locked": false,
      "text": "while True:                         # replay matches\n    board = [1,2,3,4,5,6,7,8,9]\n    while True:                      # one match\n        print_board(board)\n        # get and validate the human's move\n        # place X, then check human win / draw\n        # call computer_move(board), then place O\n        # check computer win / draw\n    # update score and ask whether to play again",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 21,
      "lineHeight": 1.25,
      "autoResize": false,
      "originalText": "while True:                         # replay matches\n    board = [1,2,3,4,5,6,7,8,9]\n    while True:                      # one match\n        print_board(board)\n        # get and validate the human's move\n        # place X, then check human win / draw\n        # call computer_move(board), then place O\n        # check computer win / draw\n    # update score and ask whether to play again",
      "containerId": null,
      "labelPosition": 0.5,
      "baseFontSize": null
    },
    {
      "id": "63fc0aca4ef4444c9dc6",
      "type": "text",
      "x": 1948.0327811704915,
      "y": 1663.31422449238,
      "width": 1614,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0W",
      "roundness": {
        "type": 3
      },
      "seed": 892765,
      "version": 343,
      "versionNonce": 1599954072,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793378608687,
      "link": null,
